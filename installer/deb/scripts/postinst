#!/bin/bash

# Postinstall script for MassaStation installer on Linux
# It configures /etc/hosts to resolve .massa domains to localhost and other configuration (create folders, allow bind port 80...).

# `set -e` causes the script to exit if any command fails.
set -e

# Set MassaStation configuration directories.
export MASSASTATION_CONFIG_DIR=/usr/local/share/massastation
export MASSASTATION_CERT_DIR=/etc/massastation/certs

# Print error message to stderr and exit with code 1.
fatal() {
    echo "FATAL: $1" >&2
    exit 1
}

main() {
    # Determine the unprivileged user that will actually run MassaStation.
    # The directories below are written to at runtime by that user (plugins,
    # logs, generated CA key), so we make them owned by that user with 0755
    # instead of world-writable (0777). World-writable directories on a
    # multi-user host let any local user plant plugin binaries that Station
    # executes as the victim (cross-user RCE).
    INSTALL_USER="${SUDO_USER:-$(logname 2>/dev/null || true)}"
    if [ -z "$INSTALL_USER" ] || [ "$INSTALL_USER" = "root" ]; then
        fatal "unable to determine the target user; re-run the installation from the user's session (e.g. via sudo) so MassaStation directories can be owned safely."
    fi

    # Create MassaStation configuration directories (0755, not world-writable).
    mkdir -m 755 -p $MASSASTATION_CONFIG_DIR || fatal "config directory creation failed."
    mkdir -m 755 -p $MASSASTATION_CONFIG_DIR/plugins || fatal "plugins directory creation failed."
    mkdir -m 755 -p $MASSASTATION_CONFIG_DIR/logs || fatal "logs directory creation failed."
    mkdir -m 755 -p $MASSASTATION_CERT_DIR || fatal "certs directory creation failed."

    # Hand ownership to the runtime user so Station can write without 0777.
    chown -R "$INSTALL_USER" $MASSASTATION_CONFIG_DIR || fatal "failed to set ownership of config directory."
    chown -R "$INSTALL_USER" $MASSASTATION_CERT_DIR || fatal "failed to set ownership of certs directory."

    # If station.massa is not resolved, we add its redirection to /etc/hosts.
    ping -c 1 -t 1 station.massa &> /dev/null || echo "127.0.0.1 station.massa" >> /etc/hosts || fatal "Failed to add station.massa to /etc/hosts."

    # Setcap massastation to allow binding to privileged ports (80, 443).
    setcap CAP_NET_BIND_SERVICE=+eip /usr/bin/massastation || fatal "Failed to setcap massastation."
}

case "$1" in
    configure)
        main
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
